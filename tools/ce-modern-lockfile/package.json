{
  "name": "conectaempresa",
  "private": true,
  "version": "0.0.0-modernization",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "modern:dev": "vite --config vite.modern.config.ts",
    "modern:build": "tsc -p tsconfig.modern.json --noEmit && vite build --config vite.modern.config.ts",
    "modern:typecheck": "tsc -p tsconfig.modern.json --noEmit",
    "modern:test": "vitest run --config vitest.modern.config.ts",
    "modern:test:watch": "vitest --config vitest.modern.config.ts",
    "modern:lint": "eslint --config eslint.config.mjs src modern vite.modern.config.ts vitest.modern.config.ts",
    "modern:preflight": "node scripts/preflight-ce-modernization-001.js",
    "modern:lifecycle": "node scripts/preflight-ce-modernization-module-lifecycle.js",
    "modern:deps-preflight": "node scripts/preflight-ce-modernization-dependencies.js",
    "modern:env-preflight": "node scripts/preflight-ce-modernization-browser-env.js",
    "modern:route-preflight": "node scripts/preflight-ce-modernization-route-lazy.js",
    "modern:layer-preflight": "node scripts/preflight-ce-modernization-layer-boundaries.js",
    "modern:lockfile": "node scripts/ce-modernization-generate-lockfile.js",
    "modern:output-security": "node scripts/preflight-ce-modernization-build-output-security.js",
    "modern:performance-budget": "node scripts/preflight-ce-modernization-performance-budget.js",
    "modern:artifact-preflight": "node scripts/preflight-ce-modernization-artifact-contract.js",
    "modern:artifact-manifest": "node scripts/ce-modernization-artifact-manifest.js",
    "modern:artifact-verify": "node scripts/preflight-ce-modernization-artifact-integrity.js",
    "modern:cert-preflight": "node scripts/preflight-ce-modernization-certification.js",
    "modern:certify": "node scripts/ce-modernization-certify.js"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.16.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
